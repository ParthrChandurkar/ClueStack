# Example backend environment for local development.
INFRAWATCH_ENVIRONMENT=development
INFRAWATCH_EXECUTE_KUBECTL=false
INFRAWATCH_KUBECTL_NAMESPACE=infrawatch
# Optional local kubeconfig override for read-only Cluster Overview access.
# INFRAWATCH_KUBECONFIG_PATH=C:\Users\you\.kube\config
INFRAWATCH_KUBERNETES_REQUEST_TIMEOUT_SECONDS=10
INFRAWATCH_PROMETHEUS_URL=http://localhost:9090
INFRAWATCH_LOKI_URL=http://localhost:3100
INFRAWATCH_STATE_FILE=/tmp/infrawatch/deployments.json
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=5
